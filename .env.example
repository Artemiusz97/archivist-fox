# ==============================================================================
# Archivist Fox - Environment Configuration
# ==============================================================================

# Required Discord Bot Token
DISCORD_TOKEN=

# Channel Access Filtering (optional)
# ALLOWED_CHANNEL_IDS=
# DISALLOWED_CHANNEL_IDS=

# Discord Upload & Download Caps
MAX_FILE_SIZE_MB=10
HARD_CAP_MB=2000
ENABLE_COMPRESSION=true
CLEANUP_TEMP_FILES=true

# Performance & Processing
GPU_ACCELERATION=auto
MAX_CONCURRENT_DOWNLOADS=2
SCANNER_CONCURRENCY=3
AUTO_SUPPRESS_EMBEDS=true
INCLUDE_TITLE_IN_MESSAGE=true
EMBED_THUMBNAIL=true
PREPEND_THUMBNAIL_PREVIEW=true

# Audio & Music Platform Extraction (v3.5.0)
ENABLE_AUDIO_EXTRACTION=true
AUDIO_FORMAT=mp3
AUDIO_QUALITY=0
MAX_AUDIO_BITRATE_KBPS=320

# Permanent Local PC Archiving
ENABLE_LOCAL_ARCHIVE=true
ARCHIVE_DIRECTORY=./archives
ARCHIVE_SAVE_METADATA=true
ARCHIVE_SUBFOLDER_FORMAT=channel/date

# Duplicate Prevention (Visual + Media ID + SHA256)
ENABLE_DUPLICATE_PREVENTION=true
DUPLICATE_HAMMING_THRESHOLD=5

# General Link Detector (SQLite)
ENABLE_GENERAL_DUPLICATE_DETECTOR=true
DUPLICATE_LINK_SCOPE=channel
DUPLICATE_LINK_RETENTION_DAYS=0
SELF_REPOST_GRACE_SECONDS=300
DUPLICATE_LINK_ALERT_TTL_SECONDS=0
LINK_DB_PATH=./data/links.db

# Auto-Updates & Maintenance
ENABLE_AUTO_UPDATE_BINARIES=true
AUTO_UPDATE_INTERVAL_HOURS=24
ERROR_MESSAGE_TTL_SECONDS=0
RETRY_COMMAND=!repost

# Automatic Startup Catch-Up Scan (for when bot / PC is turned off)
AUTO_SCAN_ON_STARTUP=true
AUTO_SCAN_HOURS=24
AUTO_SCAN_REPOST_MISSING=true
AUTO_SCAN_CONCURRENCY=3

# Browser Cookies Authentication (optional: firefox, chrome, edge, brave)
COOKIES_FROM_BROWSER=firefox
PREFER_BROWSER_COOKIES=false

# Anti-Bot & Scraper Hardening (Human-Mimicking)
# IMPERSONATE_BROWSER options: auto (matches COOKIES_FROM_BROWSER or chrome), chrome, firefox, edge, safari, off
IMPERSONATE_BROWSER=auto
ENABLE_HUMAN_JITTER=true
HUMAN_JITTER_MIN_MS=1500
HUMAN_JITTER_MAX_MS=3500
