# ==============================================================================
# Archivist Fox - Environment Configuration
# ==============================================================================

# Required Discord Bot Token
DISCORD_TOKEN=

# Channel Access Filtering (optional)
# ALLOWED_CHANNEL_IDS=
# DISALLOWED_CHANNEL_IDS=

# Discord Upload & Download Caps
MAX_FILE_SIZE_MB=10
HARD_CAP_MB=2000
ENABLE_COMPRESSION=true
CLEANUP_TEMP_FILES=true

# Performance & Processing
GPU_ACCELERATION=auto
SCANNER_CONCURRENCY=3
MAX_CONCURRENT_DOWNLOADS=3
MAX_QUEUE_DEPTH=50

# --- YouTube Playlist Settings ---
# Enable fetching and interactive prompting for YouTube playlists
ENABLE_PLAYLIST_DOWNLOAD=true
# Maximum number of videos to parse and download from a single playlist
MAX_PLAYLIST_ITEMS=25
# Automatically create a thread to post playlist videos to avoid channel clutter
PLAYLIST_AUTO_THREAD=true
# Timeout in seconds before defaulting to downloading just the single video (or cancelling if it's a pure playlist link)
PLAYLIST_PROMPT_TIMEOUT_SECONDS=30

# --- Caption & Subtitle Extraction ---
# Automatically download and archive creator-provided subtitles/captions locally
ENABLE_SUBTITLES=true
# Upload subtitle files into Discord chat (false = save to local archive only, keeping Discord clean)
UPLOAD_SUBTITLES_TO_DISCORD=true
# Source of subtitles ('creator' for manual subs, 'all' for manual + youtube auto-generated)
SUBTITLE_SOURCE=creator
# Preferred subtitle languages (e.g. 'all', 'en.*,ja', 'en')
SUBTITLE_LANGS=en.*,en
# Target subtitle format
SUBTITLE_FORMAT=srt
# Zips subtitle files if a video has many language tracks to avoid spamming Discord attachments
ZIP_MULTI_SUBTITLES=true
MAX_INDIVIDUAL_SUBTITLES=3

AUTO_SUPPRESS_EMBEDS=true
INCLUDE_TITLE_IN_MESSAGE=true
EMBED_THUMBNAIL=true
PREPEND_THUMBNAIL_PREVIEW=true

# Auto-Spoiler NSFW & Sensitive Media
# Automatically blur (spoiler) reuploaded media tagged as NSFW/sensitive by the original site (set false to disable)
AUTO_SPOILER_NSFW=true
# false = blur site-tagged NSFW media across ALL channels by default; true = only blur in non-NSFW channels
SPOILER_NON_NSFW_CHANNELS_ONLY=false
SPOILER_USER_FLAGGED_LINKS=true
SPOILER_TITLES=true

# Audio & Music Platform Extraction (v3.5.0)
ENABLE_AUDIO_EXTRACTION=true
AUDIO_FORMAT=mp3
AUDIO_QUALITY=0
MAX_AUDIO_BITRATE_KBPS=320

# High-Quality GIF Pipeline & Dual-Format Archiving (v3.12.0)
# Automatically detect short silent videos (< 6s) or original platform GIFs and process in full-quality GIF format
ENABLE_GIF_PIPELINE=true
# Maximum duration (in seconds) of a silent video clip to qualify for GIF conversion
GIF_MAX_DURATION_SECONDS=6
# Maximum framerate for generated GIFs (24-30 recommended for smooth motion without file bloat)
GIF_MAX_FPS=30
# Retain both MP4 and GIF formats in the local PC archive (with smart fallback to MP4 on Discord if GIF > upload limit)
ARCHIVE_BOTH_FORMATS=true

# Permanent Local PC Archiving
ENABLE_LOCAL_ARCHIVE=true
# Also back up media files manually uploaded/attached by users in allowed channels
ARCHIVE_USER_ATTACHMENTS=true
ARCHIVE_DIRECTORY=./archives
ARCHIVE_SAVE_METADATA=true
ARCHIVE_SUBFOLDER_FORMAT=channel/date

# Duplicate Prevention (Visual + Media ID + SHA256)
ENABLE_DUPLICATE_PREVENTION=true
DUPLICATE_HAMMING_THRESHOLD=5

# General Link Detector (SQLite)
ENABLE_GENERAL_DUPLICATE_DETECTOR=true
DUPLICATE_LINK_SCOPE=channel
DUPLICATE_LINK_RETENTION_DAYS=0
SELF_REPOST_GRACE_SECONDS=300
DUPLICATE_LINK_ALERT_TTL_SECONDS=0
LINK_DB_PATH=./data/links.db

# --- Link Backup & Disaster Recovery System ---
# Comma-separated list of channel names or IDs to backup (leave blank to backup all allowed channels)
# Examples: LINK_BACKUP_CHANNELS=misc-links,misc-gaming-links,anime,movies
LINK_BACKUP_CHANNELS=
# Destination directory on your PC for exported link backups (JSON, Markdown, CSV)
LINK_BACKUP_DIR=./backups/links
# Delay in milliseconds between reposting links during restoration to respect Discord rate limits
RESTORE_PACE_DELAY_MS=1500

# Auto-Updates & Maintenance
ENABLE_AUTO_UPDATE_BINARIES=true
AUTO_UPDATE_INTERVAL_HOURS=24
ERROR_MESSAGE_TTL_SECONDS=0
RETRY_COMMAND=!repost

# Chat Command Cleanup (!retry, !rescan, !stop, !help, etc.)
AUTO_DELETE_COMMAND_MESSAGES=true
COMMAND_MESSAGE_TTL_SECONDS=4

# Automatic Startup Catch-Up Scan (for when bot / PC is turned off)
AUTO_SCAN_ON_STARTUP=true
AUTO_SCAN_HOURS=24
AUTO_SCAN_REPOST_MISSING=true
AUTO_SCAN_CONCURRENCY=3

# Browser Cookies Authentication (optional: firefox, chrome, edge, brave)
COOKIES_FROM_BROWSER=firefox
PREFER_BROWSER_COOKIES=true

# Platform-Specific Authentication & API Credentials (optional)
# Reddit OAuth API (bypasses Reddit rate limits / scraping blocks)
# REDDIT_CLIENT_ID=
# REDDIT_USER_AGENT=ArchivistFox/3.13.0
# REDDIT_REFRESH_TOKEN=

# Instagram Account Credentials (optional fallback if browser cookies are not used)
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=

# Pixiv OAuth Refresh Token (optional: gallery-dl caches automatically after running `gallery-dl oauth:pixiv`)
# PIXIV_REFRESH_TOKEN=

# Force Python module execution for gallery-dl (`python -m gallery_dl`) instead of standalone binary
USE_PYTHON_GALLERYDL=false

# Anti-Bot & Scraper Hardening (Human-Mimicking)
# IMPERSONATE_BROWSER options: auto (matches COOKIES_FROM_BROWSER or chrome), chrome, firefox, edge, safari, off
IMPERSONATE_BROWSER=auto
ENABLE_HUMAN_JITTER=true
HUMAN_JITTER_MIN_MS=1500
HUMAN_JITTER_MAX_MS=3500

# Web UI Direct Downloader Configuration
# ENABLE_WEB_UI=true
# WEB_PORT=3000
# WEB_HOST=127.0.0.1
# WEB_AUTH_TOKEN=

